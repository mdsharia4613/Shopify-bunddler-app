{% comment %}
  Smart Multi-Collection Step Bundle Widget
  Dynamic Collection Selection & Product Picker Modal
{% endcomment %}

{% assign bundle_meta = app.metafields.smart_bundles.active_bundle.value %}
{% assign display_heading = block.settings.heading %}
{% assign display_discount = block.settings.discount_percent %}

{% if bundle_meta %}
  {% if bundle_meta.title != blank %}
    {% assign display_heading = bundle_meta.title %}
  {% endif %}
  {% if bundle_meta.discountPercent != blank %}
    {% assign display_discount = bundle_meta.discountPercent %}
  {% endif %}
{% endif %}

<div 
  class="smart-bundle-container" 
  id="smart-bundle-{{ block.id }}"
  data-discount="{{ display_discount }}"
  data-accent="{{ block.settings.accent_color }}"
  data-bundle-id="{{ bundle_meta.id }}"
  style="
    --sb-accent: {{ block.settings.accent_color }};
    --sb-bg: {{ block.settings.bg_color }};
    --sb-text: {{ block.settings.text_color }};
  "
>
  <div class="smart-bundle-card">
    <!-- Header -->
    <div class="smart-bundle-header">
      <div class="smart-bundle-title-wrap">
        <span class="smart-bundle-sparkle">✨</span>
        <h3 class="smart-bundle-title">{{ display_heading }}</h3>
      </div>
      <span class="smart-bundle-badge">Bundle & Save {{ display_discount }}%</span>
    </div>

    <!-- Subtitle / Info -->
    <p class="smart-bundle-subtitle">
      Pick 1 item from each collection below to unlock <strong>{{ display_discount }}% OFF</strong> instantly.
    </p>

    <!-- Dynamic Collection Step Rows Container -->
    <div class="smart-bundle-steps" id="sb-steps-{{ block.id }}">
      <div class="sb-loading-placeholder" style="text-align: center; padding: 20px; color: #a1a1aa; font-size: 13px;">
        Loading bundle collections...
      </div>
    </div>

    <!-- Summary & Pricing Section -->
    <div class="smart-bundle-footer">
      <div class="smart-bundle-pricing">
        <div class="smart-bundle-total-row">
          <span class="smart-bundle-total-label">Bundle Total:</span>
          <span class="smart-bundle-original-price" id="sb-orig-price-{{ block.id }}"></span>
          <span class="smart-bundle-final-price" id="sb-final-price-{{ block.id }}"></span>
        </div>
        <div class="smart-bundle-savings-badge" id="sb-savings-{{ block.id }}">
          Save {{ display_discount }}%
        </div>
      </div>

      <button type="button" class="smart-bundle-btn" id="sb-add-btn-{{ block.id }}">
        <span class="smart-bundle-btn-text">Add Complete Bundle to Cart</span>
        <span class="smart-bundle-btn-icon">⚡</span>
      </button>
      <div class="smart-bundle-feedback" id="sb-feedback-{{ block.id }}"></div>
    </div>
  </div>

  <!-- Storefront Collection Product Picker Modal -->
  <div class="sb-modal-overlay" id="sb-modal-{{ block.id }}" style="display: none;">
    <div class="sb-modal-card">
      <div class="sb-modal-header">
        <div>
          <div class="sb-modal-step-tag" id="sb-modal-step-tag-{{ block.id }}">Step Collection</div>
          <h4 class="sb-modal-title" id="sb-modal-title-{{ block.id }}">Choose a Product</h4>
        </div>
        <button type="button" class="sb-modal-close" id="sb-modal-close-{{ block.id }}">✕</button>
      </div>
      
      <div class="sb-modal-body" id="sb-modal-body-{{ block.id }}">
        <div style="text-align: center; padding: 30px; color: #71717a;">Loading products from collection...</div>
      </div>
    </div>
  </div>
</div>

<style>
  .smart-bundle-container {
    margin: 24px 0;
    font-family: inherit;
    position: relative;
  }
  .smart-bundle-card {
    background-color: var(--sb-bg, #18181b);
    color: var(--sb-text, #ffffff);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3), 0 0 15px rgba(245, 158, 11, 0.08);
  }
  .smart-bundle-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 12px;
    margin-bottom: 10px;
  }
  .smart-bundle-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .smart-bundle-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
  }
  .smart-bundle-badge {
    background: linear-gradient(135deg, var(--sb-accent, #f59e0b), #d97706);
    color: #000;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 6px rgba(245, 158, 11, 0.3);
  }
  .smart-bundle-subtitle {
    font-size: 0.86rem;
    color: #a1a1aa;
    margin: 0 0 16px 0;
  }
  .smart-bundle-steps {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 18px;
  }
  .sb-step-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    transition: all 0.2s ease;
  }
  .sb-step-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(245, 158, 11, 0.35);
  }
  .sb-step-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .sb-step-thumb {
    width: 52px;
    height: 52px;
    border-radius: 6px;
    overflow: hidden;
    background: #27272a;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .sb-step-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sb-step-info {
    flex: 1;
    min-width: 0;
  }
  .sb-step-badge {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sb-accent, #f59e0b);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sb-step-product-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: #f4f4f5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 2px 0;
  }
  .sb-step-price {
    font-size: 0.85rem;
    color: #d4d4d8;
    font-weight: 500;
  }
  .sb-change-btn {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .sb-change-btn:hover {
    background: var(--sb-accent, #f59e0b);
    border-color: var(--sb-accent, #f59e0b);
    color: #000;
  }
  .sb-step-separator {
    text-align: center;
    color: #71717a;
    font-size: 16px;
    font-weight: bold;
    margin: -6px 0;
  }
  .smart-bundle-footer {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .smart-bundle-pricing {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .smart-bundle-total-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .smart-bundle-total-label {
    font-size: 0.88rem;
    color: #a1a1aa;
    font-weight: 500;
  }
  .smart-bundle-original-price {
    font-size: 0.92rem;
    color: #71717a;
    text-decoration: line-through;
  }
  .smart-bundle-final-price {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--sb-accent, #f59e0b);
  }
  .smart-bundle-savings-badge {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
  }
  .smart-bundle-btn {
    width: 100%;
    background: linear-gradient(135deg, var(--sb-accent, #f59e0b), #d97706);
    color: #000;
    border: none;
    padding: 13px 20px;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.15s ease, filter 0.15s ease;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }
  .smart-bundle-btn:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .smart-bundle-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
  .smart-bundle-feedback {
    font-size: 0.82rem;
    text-align: center;
    min-height: 18px;
  }
  .smart-bundle-feedback.success { color: #4ade80; }
  .smart-bundle-feedback.error { color: #f87171; }

  /* Modal Styling */
  .sb-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .sb-modal-card {
    background: #18181b;
    color: #ffffff;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 12px;
    width: 100%;
    max-width: 520px;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }
  .sb-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .sb-modal-step-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sb-accent, #f59e0b);
    text-transform: uppercase;
  }
  .sb-modal-title {
    margin: 2px 0 0 0;
    font-size: 1.1rem;
    font-weight: 700;
  }
  .sb-modal-close {
    background: none;
    border: none;
    color: #a1a1aa;
    font-size: 20px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
  }
  .sb-modal-close:hover { color: #ffffff; }
  .sb-modal-body {
    padding: 16px 20px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sb-modal-product-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    gap: 12px;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .sb-modal-product-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(245, 158, 11, 0.4);
  }
  .sb-modal-product-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .sb-modal-product-img {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    object-fit: cover;
    background: #27272a;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .sb-modal-product-name {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sb-modal-product-price {
    font-size: 0.85rem;
    color: #a1a1aa;
    margin-top: 2px;
  }
  .sb-modal-select-btn {
    background: linear-gradient(135deg, var(--sb-accent, #f59e0b), #d97706);
    color: #000;
    font-size: 0.8rem;
    font-weight: 700;
    border: none;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
  }
</style>

<script>
  (function() {
    const container = document.getElementById('smart-bundle-{{ block.id }}');
    if (!container) return;

    const stepsContainer = document.getElementById('sb-steps-{{ block.id }}');
    const origPriceEl = document.getElementById('sb-orig-price-{{ block.id }}');
    const finalPriceEl = document.getElementById('sb-final-price-{{ block.id }}');
    const savingsEl = document.getElementById('sb-savings-{{ block.id }}');
    const addBtn = document.getElementById('sb-add-btn-{{ block.id }}');
    const feedbackEl = document.getElementById('sb-feedback-{{ block.id }}');

    // Modal elements
    const modalEl = document.getElementById('sb-modal-{{ block.id }}');
    const modalCloseBtn = document.getElementById('sb-modal-close-{{ block.id }}');
    const modalTitleEl = document.getElementById('sb-modal-title-{{ block.id }}');
    const modalStepTagEl = document.getElementById('sb-modal-step-tag-{{ block.id }}');
    const modalBodyEl = document.getElementById('sb-modal-body-{{ block.id }}');

    let discountPercent = parseFloat(container.dataset.discount || 15);
    let bundleSteps = [];
    let activeStepIndex = null;
    let collectionProductsCache = {};

    function formatMoney(cents) {
      return (cents / 100).toLocaleString(undefined, {
        style: 'currency',
        currency: '{{ cart.currency.iso_code }}'
      });
    }

    // Modal Controls
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', () => { modalEl.style.display = 'none'; });
    }
    if (modalEl) {
      modalEl.addEventListener('click', (e) => {
        if (e.target === modalEl) modalEl.style.display = 'none';
      });
    }

    async function openModalForStep(stepIndex) {
      activeStepIndex = stepIndex;
      const step = bundleSteps[stepIndex];
      if (!step) return;

      modalStepTagEl.textContent = `Step ${stepIndex + 1} Collection`;
      modalTitleEl.textContent = step.collectionTitle || 'Select Product';
      modalBodyEl.innerHTML = '<div style="text-align:center; padding: 30px; color: #a1a1aa;">Loading products...</div>';
      modalEl.style.display = 'flex';

      const handle = step.collectionHandle || (step.collectionTitle ? step.collectionTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-') : '');
      let productsList = collectionProductsCache[handle];

      if (!productsList) {
        try {
          const fetchUrl = handle ? `/collections/${handle}/products.json` : '/products.json';
          const res = await fetch(fetchUrl);
          if (res.ok) {
            const data = await res.json();
            productsList = data.products || [];
            collectionProductsCache[handle] = productsList;
          }
        } catch (e) {
          console.error('Error fetching collection products:', e);
        }
      }

      if (!productsList || productsList.length === 0) {
        modalBodyEl.innerHTML = '<div style="text-align:center; padding: 30px; color: #71717a;">No products found in this collection.</div>';
        return;
      }

      modalBodyEl.innerHTML = '';
      productsList.forEach(p => {
        const variant = p.variants && p.variants[0];
        const priceCents = variant ? Math.round(parseFloat(variant.price) * 100) : 0;
        const imgUrl = (p.images && p.images[0] && p.images[0].src) || p.image?.src || 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png';

        const itemEl = document.createElement('div');
        itemEl.className = 'sb-modal-product-item';
        itemEl.innerHTML = `
          <div class="sb-modal-product-left">
            <img src="${imgUrl}" alt="${p.title}" class="sb-modal-product-img" width="48" height="48">
            <div style="flex:1; min-width:0;">
              <div class="sb-modal-product-name">${p.title}</div>
              <div class="sb-modal-product-price">${formatMoney(priceCents)}</div>
            </div>
          </div>
          <button type="button" class="sb-modal-select-btn">Choose Item ✓</button>
        `;

        itemEl.addEventListener('click', () => {
          selectProductForStep(stepIndex, {
            id: p.id,
            title: p.title,
            variantId: variant ? variant.id : null,
            price: priceCents,
            imageUrl: imgUrl
          });
          modalEl.style.display = 'none';
        });

        modalBodyEl.appendChild(itemEl);
      });
    }

    function selectProductForStep(stepIndex, product) {
      if (!bundleSteps[stepIndex]) return;
      bundleSteps[stepIndex].selectedProduct = product;
      renderSteps();
      recalculate();
    }

    function recalculate() {
      let rawTotal = 0;
      let allChosen = true;

      bundleSteps.forEach(s => {
        if (s.selectedProduct && s.selectedProduct.price) {
          rawTotal += s.selectedProduct.price;
        } else {
          allChosen = false;
        }
      });

      const discount = rawTotal * (discountPercent / 100);
      const finalTotal = rawTotal - discount;

      if (origPriceEl) {
        origPriceEl.textContent = allChosen ? formatMoney(rawTotal) : '';
      }
      if (finalPriceEl) {
        finalPriceEl.textContent = formatMoney(finalTotal);
      }
      if (savingsEl) {
        savingsEl.textContent = allChosen ? `Save ${formatMoney(discount)} (${discountPercent}%)` : `Select all ${bundleSteps.length} collections to save ${discountPercent}%`;
      }
      if (addBtn) {
        addBtn.disabled = !allChosen;
      }
    }

    function renderSteps() {
      if (!stepsContainer) return;
      stepsContainer.innerHTML = '';

      bundleSteps.forEach((step, idx) => {
        if (idx > 0) {
          const plus = document.createElement('div');
          plus.className = 'sb-step-separator';
          plus.textContent = '+';
          stepsContainer.appendChild(plus);
        }

        const card = document.createElement('div');
        card.className = 'sb-step-card';

        const p = step.selectedProduct;
        const imgUrl = p ? p.imageUrl : 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png';
        const title = p ? p.title : `Click to select from ${step.collectionTitle || 'Collection'}`;
        const price = p ? formatMoney(p.price) : 'Eligible for bundle';

        card.innerHTML = `
          <div class="sb-step-left">
            <div class="sb-step-thumb">
              <img src="${imgUrl}" alt="${title}" width="52" height="52">
            </div>
            <div class="sb-step-info">
              <div class="sb-step-badge">Step ${idx + 1} • ${step.collectionTitle || 'Collection ' + (idx + 1)}</div>
              <div class="sb-step-product-name">${title}</div>
              <div class="sb-step-price">${price}</div>
            </div>
          </div>
          <button type="button" class="sb-change-btn">
            ${p ? '🔄 Change Item' : '➕ Select Item'}
          </button>
        `;

        card.addEventListener('click', () => openModalForStep(idx));
        stepsContainer.appendChild(card);
      });
    }

    // Initialize bundle data from API or Metafield
    async function initBundle() {
      try {
        const res = await fetch('/api/bundles');
        if (res.ok) {
          const data = await res.json();
          if (data.bundles && data.bundles.length > 0) {
            const active = data.bundles[0];
            discountPercent = parseFloat(active.discountPercent || 15);
            container.dataset.discount = discountPercent;

            const tEl = container.querySelector('.smart-bundle-title');
            const bEl = container.querySelector('.smart-bundle-badge');
            const sEl = container.querySelector('.smart-bundle-subtitle strong');
            if (tEl && active.title) tEl.textContent = active.title;
            if (bEl) bEl.textContent = `Bundle & Save ${discountPercent}%`;
            if (sEl) sEl.textContent = `${discountPercent}% OFF`;

            if (active.config && active.config.collectionRows && active.config.collectionRows.length > 0) {
              bundleSteps = active.config.collectionRows.map((r, i) => ({
                stepIndex: i,
                collectionId: r.collectionId,
                collectionTitle: r.collectionTitle || `Collection ${i + 1}`,
                collectionHandle: r.collectionHandle || '',
                selectedProduct: null
              }));
            }
          }
        }
      } catch (err) {
        console.error('Error fetching bundles:', err);
      }

      // Fallback steps if no collectionRows defined
      if (bundleSteps.length === 0) {
        bundleSteps = [
          { stepIndex: 0, collectionTitle: 'Collection 1', collectionHandle: 'collection-1', selectedProduct: null },
          { stepIndex: 1, collectionTitle: 'collection 2', collectionHandle: 'collection-2', selectedProduct: null }
        ];
      }

      // Auto pre-select first product for each collection step
      for (let i = 0; i < bundleSteps.length; i++) {
        const handle = bundleSteps[i].collectionHandle || (bundleSteps[i].collectionTitle ? bundleSteps[i].collectionTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-') : '');
        try {
          const res = await fetch(handle ? `/collections/${handle}/products.json` : '/products.json');
          if (res.ok) {
            const data = await res.json();
            const prods = data.products || [];
            if (prods.length > 0) {
              const p = prods[0];
              const variant = p.variants && p.variants[0];
              const priceCents = variant ? Math.round(parseFloat(variant.price) * 100) : 10000;
              const imgUrl = (p.images && p.images[0] && p.images[0].src) || p.image?.src || 'https://cdn.shopify.com/s/files/1/0533/2089/files/placeholder-images-image_large.png';

              bundleSteps[i].selectedProduct = {
                id: p.id,
                title: p.title,
                variantId: variant ? variant.id : null,
                price: priceCents,
                imageUrl: imgUrl
              };
            }
          }
        } catch (e) {}
      }

      renderSteps();
      recalculate();
    }

    initBundle();

        // Add to cart handler with Cart Merge & Checkout Discount payload
    if (addBtn) {
      addBtn.addEventListener('click', async function() {
        // Validation: Ensure all steps have a selected product
        const missingSteps = bundleSteps.filter(s => !s.selectedProduct || !s.selectedProduct.variantId);
        if (missingSteps.length > 0) {
          if (feedbackEl) {
            feedbackEl.className = 'smart-bundle-feedback error';
            feedbackEl.textContent = `Please pick a product from each of the ${bundleSteps.length} collections.`;
          }
          return;
        }

        addBtn.disabled = true;
        const btnText = addBtn.querySelector('.smart-bundle-btn-text');
        if (btnText) btnText.textContent = 'Adding bundle to cart...';

        const bundleGroupId = 'bundle_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6);
        const titles = bundleSteps.map(s => s.selectedProduct.title);
        const bundleTitle = 'Bundle: ' + titles.join(' + ');
        const bundleIncludes = titles.join(', ');

        let totalOriginalCents = 0;
        bundleSteps.forEach(s => {
          totalOriginalCents += (s.selectedProduct.price || 0);
        });
        const totalDiscountCents = Math.round(totalOriginalCents * (1 - (discountPercent / 100)));
        const primaryImage = bundleSteps[0]?.selectedProduct?.imageUrl || '';
        const parentVariantId = window.SmartBundles?.parentVariantId || '';
        const discountCode = window.SmartBundles?.discountCode || ('BUNDLE' + discountPercent);

        const items = [];
        bundleSteps.forEach((s, idx) => {
          items.push({
            id: parseInt(s.selectedProduct.variantId, 10),
            quantity: 1,
            properties: {
              '_bundle': 'Smart Multi-Collection Bundle',
              '_bundle_group': bundleGroupId,
              '_bundle_title': bundleTitle,
              '_bundle_components': bundleIncludes,
              '_bundle_discount': `${discountPercent}%`,
              '_bundle_discount_num': discountPercent.toString(),
              '_bundle_original_cents': totalOriginalCents.toString(),
              '_bundle_discounted_cents': totalDiscountCents.toString(),
              '_bundle_image': primaryImage,
              '_bundle_parent_variant_id': parentVariantId,
              '_bundle_discount_code': discountCode,
              '_bundle_index': idx.toString(),
              'Bundle': bundleTitle,
              'Includes': bundleIncludes
            }
          });
        });

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (res.ok) {
            // Auto-apply discount code for checkout
            if (discountCode) {
              try {
                await fetch('/discount/' + encodeURIComponent(discountCode));
              } catch (e) {}
            }
            if (feedbackEl) {
              feedbackEl.className = 'smart-bundle-feedback success';
              feedbackEl.textContent = '🎉 Bundle successfully added to cart!';
            }
            setTimeout(() => { window.location.href = '/cart'; }, 500);
          } else {
            const err = await res.json();
            throw new Error(err.description || 'Could not add bundle items to cart.');
          }
        } catch (e) {
          addBtn.disabled = false;
          if (btnText) btnText.textContent = 'Add Complete Bundle to Cart';
          if (feedbackEl) {
            feedbackEl.className = 'smart-bundle-feedback error';
            feedbackEl.textContent = e.message || 'Error adding to cart.';
          }
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Multi-Collection Bundle",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "range", "id": "discount_percent", "min": 5, "max": 50, "step": 5, "unit": "%", "label": "Bundle Discount", "default": 15 },
    { "type": "color", "id": "accent_color", "label": "Accent Color", "default": "#f59e0b" },
    { "type": "color", "id": "bg_color", "label": "Card Background", "default": "#18181b" },
    { "type": "color", "id": "text_color", "label": "Text Color", "default": "#ffffff" }
  ]
}
{% endschema %}
