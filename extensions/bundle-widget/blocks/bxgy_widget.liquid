{% render 'bxgy_snippet', widget_instance_id: block.id, is_standalone: false %}

{% schema %}
{
  "name": "Buy X Get Y Deal",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Heading",
      "default": "Buy X, Get Y (BXGY) Special"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active Accent Color",
      "default": "#f59e0b"
    }
  ]
}
{% endschema %}
