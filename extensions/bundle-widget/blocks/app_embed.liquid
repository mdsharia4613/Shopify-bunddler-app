{% comment %}
  Smart Bundles Global App Embed
  Enables / Disables the bundle engine and widgets across the entire store
{% endcomment %}

<script>
  window.SmartBundles = window.SmartBundles || {};
  window.SmartBundles.enabled = true;
  window.SmartBundles.settings = {
    accentColor: "{{ block.settings.accent_color | default: '#f59e0b' }}",
    autoInject: {{ block.settings.auto_inject | default: true }},
    discountPercent: {{ block.settings.discount_percent | default: 15 }}
  };
</script>

{% assign bundle_meta = app.metafields.smart_bundles.active_bundle.value %}
{% assign embed_heading = "Smart Bundle Offer" %}
{% assign embed_discount = block.settings.discount_percent | default: 15 %}

{% if bundle_meta %}
  {% if bundle_meta.title != blank %}
    {% assign embed_heading = bundle_meta.title %}
  {% endif %}
  {% if bundle_meta.discountPercent != blank %}
    {% assign embed_discount = bundle_meta.discountPercent %}
  {% endif %}
{% endif %}

{% if block.settings.auto_inject and template.name == 'product' %}
  {% assign main_product = product %}
  {% assign comp_item = blank %}
  {% for p in collections['all'].products %}
    {% if p.id != main_product.id and comp_item == blank and p.available %}
      {% assign comp_item = p %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if comp_item %}
    <template id="smart-bundles-auto-template">
      <div 
        class="smart-bundle-container smart-bundle-embed-container" 
        id="smart-bundle-embed-{{ block.id }}"
        data-discount="{{ embed_discount }}"
        style="
          --sb-accent: {{ block.settings.accent_color | default: '#f59e0b' }};
          --sb-bg: #18181b;
          --sb-text: #ffffff;
        "
      >
        <div class="smart-bundle-card">
          <div class="smart-bundle-header">
            <div class="smart-bundle-title-wrap">
              <span class="smart-bundle-sparkle">✨</span>
              <h3 class="smart-bundle-title">{{ embed_heading }}</h3>
            </div>
            <span class="smart-bundle-badge">Bundle & Save {{ embed_discount }}%</span>
          </div>

          <p class="smart-bundle-subtitle">
            Buy together with complementary items to unlock <strong>{{ embed_discount }}% OFF</strong> instantly.
          </p>

          <div class="smart-bundle-items">
            <!-- Main Product -->
            {% assign main_variant = main_product.selected_or_first_available_variant %}
            <div class="smart-bundle-item" data-price="{{ main_variant.price }}" data-variant-id="{{ main_variant.id }}">
              <label class="smart-bundle-checkbox-wrap">
                <input type="checkbox" class="smart-bundle-checkbox" checked disabled>
                <span class="smart-bundle-custom-check checked disabled">✓</span>
              </label>
              <div class="smart-bundle-thumb">
                {% if main_product.featured_image %}
                  <img src="{{ main_product.featured_image | image_url: width: 140 }}" alt="{{ main_product.title }}" width="70" height="70" loading="lazy">
                {% else %}
                  <div class="smart-bundle-thumb-placeholder">📦</div>
                {% endif %}
              </div>
              <div class="smart-bundle-details">
                <div class="smart-bundle-step-tag">Step 1 • Current Product</div>
                <div class="smart-bundle-product-title">{{ main_product.title }}</div>
                <div class="smart-bundle-price-tag">{{ main_variant.price | money }}</div>
              </div>
            </div>

            <div class="smart-bundle-plus">+</div>

            <!-- Complementary Product -->
            {% assign comp_variant = comp_item.selected_or_first_available_variant %}
            <div class="smart-bundle-item" data-price="{{ comp_variant.price }}" data-variant-id="{{ comp_variant.id }}">
              <label class="smart-bundle-checkbox-wrap">
                <input type="checkbox" class="smart-bundle-checkbox" checked>
                <span class="smart-bundle-custom-check checked">✓</span>
              </label>
              <div class="smart-bundle-thumb">
                {% if comp_item.featured_image %}
                  <img src="{{ comp_item.featured_image | image_url: width: 140 }}" alt="{{ comp_item.title }}" width="70" height="70" loading="lazy">
                {% else %}
                  <div class="smart-bundle-thumb-placeholder">📦</div>
                {% endif %}
              </div>
              <div class="smart-bundle-details">
                <div class="smart-bundle-step-tag">Step 2 • Frequently Bought Together</div>
                <div class="smart-bundle-product-title">{{ comp_item.title }}</div>
                <div class="smart-bundle-price-tag">{{ comp_variant.price | money }}</div>
              </div>
            </div>
          </div>

          <div class="smart-bundle-footer">
            <div class="smart-bundle-pricing">
              <div class="smart-bundle-total-row">
                <span class="smart-bundle-total-label">Total:</span>
                <span class="smart-bundle-original-price" id="sb-orig-embed-{{ block.id }}"></span>
                <span class="smart-bundle-final-price" id="sb-final-embed-{{ block.id }}"></span>
              </div>
              <div class="smart-bundle-savings-badge" id="sb-savings-embed-{{ block.id }}">
                Save {{ embed_discount }}%
              </div>
            </div>

            <button type="button" class="smart-bundle-btn" id="sb-add-btn-embed-{{ block.id }}">
              <span class="smart-bundle-btn-text">Add Bundle to Cart</span>
              <span class="smart-bundle-btn-icon">⚡</span>
            </button>
            <div class="smart-bundle-feedback" id="sb-feedback-embed-{{ block.id }}"></div>
          </div>
        </div>
      </div>
    </template>

    <script>
      (function() {
        document.addEventListener('DOMContentLoaded', function() {
          if (document.querySelector('.smart-bundle-container:not(.smart-bundle-embed-container)')) return;

          const tmpl = document.getElementById('smart-bundles-auto-template');
          if (!tmpl) return;

          const clone = tmpl.content.cloneNode(true);
          const container = clone.querySelector('.smart-bundle-container');

          const target = document.querySelector('form[action*="/cart/add"]') || 
                         document.querySelector('.product-form') || 
                         document.querySelector('.product__info-container') ||
                         document.querySelector('.product-single__meta');

          if (target && target.parentNode) {
            target.parentNode.insertBefore(container, target.nextSibling);
            initEmbedWidget(container);
          }
        });

        function initEmbedWidget(container) {
          let discountPercent = parseFloat(container.dataset.discount || 15);

          // Dynamic Live Sync from App Database
          fetch('/api/bundles')
            .then(r => r.json())
            .then(data => {
              if (data.bundles && data.bundles.length > 0) {
                const active = data.bundles[0];
                if (active.discountPercent) {
                  discountPercent = parseFloat(active.discountPercent);
                  container.dataset.discount = discountPercent;
                  const tEl = container.querySelector('.smart-bundle-title');
                  const bEl = container.querySelector('.smart-bundle-badge');
                  const sEl = container.querySelector('.smart-bundle-subtitle strong');
                  if (tEl && active.title) tEl.textContent = active.title;
                  if (bEl) bEl.textContent = 'Bundle & Save ' + discountPercent + '%';
                  if (sEl) sEl.textContent = discountPercent + '% OFF';
                  calculate();
                }
              }
            })
            .catch(() => {});
          const origPriceEl = container.querySelector('[id^="sb-orig-embed-"]');
          const finalPriceEl = container.querySelector('[id^="sb-final-embed-"]');
          const savingsEl = container.querySelector('[id^="sb-savings-embed-"]');
          const addBtn = container.querySelector('[id^="sb-add-btn-embed-"]');
          const feedbackEl = container.querySelector('[id^="sb-feedback-embed-"]');

          function formatMoney(cents) {
            return (cents / 100).toLocaleString(undefined, {
              style: 'currency',
              currency: '{{ cart.currency.iso_code }}'
            });
          }

          function calculate() {
            let rawTotal = 0;
            let selectedCount = 0;
            const items = container.querySelectorAll('.smart-bundle-item');
            items.forEach(item => {
              const cb = item.querySelector('.smart-bundle-checkbox');
              const price = parseInt(item.dataset.price || 0, 10);
              if (cb && cb.checked) {
                rawTotal += price;
                selectedCount++;
              }
            });

            const isEligible = selectedCount >= 2;
            const discount = isEligible ? (rawTotal * (discountPercent / 100)) : 0;
            const finalTotal = rawTotal - discount;

            if (origPriceEl) {
              origPriceEl.textContent = isEligible ? formatMoney(rawTotal) : '';
              origPriceEl.style.display = isEligible ? 'inline' : 'none';
            }
            if (finalPriceEl) {
              finalPriceEl.textContent = formatMoney(finalTotal);
            }
            if (savingsEl) {
              savingsEl.textContent = isEligible ? `Save ${formatMoney(discount)} (${discountPercent}%)` : `Add 1 more to save ${discountPercent}%`;
            }
          }

          container.querySelectorAll('.smart-bundle-checkbox').forEach(cb => {
            cb.addEventListener('change', function() {
              const checkSpan = this.parentElement.querySelector('.smart-bundle-custom-check');
              if (checkSpan) {
                if (this.checked) {
                  checkSpan.classList.add('checked');
                  checkSpan.textContent = '✓';
                } else {
                  checkSpan.classList.remove('checked');
                  checkSpan.textContent = '';
                }
              }
              calculate();
            });
          });

          calculate();

          if (addBtn) {
            addBtn.addEventListener('click', async function() {
              const selectedVariants = [];
              container.querySelectorAll('.smart-bundle-item').forEach(item => {
                const cb = item.querySelector('.smart-bundle-checkbox');
                const vId = item.dataset.variantId;
                if (cb && cb.checked && vId) {
                  selectedVariants.push({
                    id: parseInt(vId, 10),
                    quantity: 1,
                    properties: { '_bundle': 'Smart Bundles App' }
                  });
                }
              });

              if (selectedVariants.length === 0) return;

              addBtn.disabled = true;
              const textSpan = addBtn.querySelector('.smart-bundle-btn-text');
              if (textSpan) textSpan.textContent = 'Adding to cart...';

              try {
                const res = await fetch('/cart/add.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                  body: JSON.stringify({ items: selectedVariants })
                });
                if (res.ok) {
                  if (feedbackEl) {
                    feedbackEl.className = 'smart-bundle-feedback success';
                    feedbackEl.textContent = '✓ Added to cart!';
                  }
                  setTimeout(() => { window.location.href = '/cart'; }, 500);
                }
              } catch (e) {
                addBtn.disabled = false;
                if (textSpan) textSpan.textContent = 'Add Bundle to Cart';
              }
            });
          }
        }
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Smart Bundles",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "auto_inject",
      "label": "Auto-inject Bundle on Product Pages",
      "default": true
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Default Bundle Discount",
      "default": 15
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#f59e0b"
    }
  ]
}
{% endschema %}
