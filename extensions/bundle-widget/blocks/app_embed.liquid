{% comment %}
  Smart Bundles Core App Embed
  Native Cart Transform Integration: Ensures accurate single $170.00 bundle price without duplicate discounts
{% endcomment %}

<script>
  window.SmartBundles = window.SmartBundles || {};
  window.SmartBundles.enabled = true;
  {% if shop.metafields.smart_bundles.active_bundle != blank %}
    try {
      window.SmartBundles.config = {{ shop.metafields.smart_bundles.active_bundle }};
    } catch(e) {}
  {% endif %}

  (function() {
    async function syncBundlePrice() {
      try {
        const res = await fetch('/cart.js');
        if (!res.ok) return;
        const cart = await res.json();
        if (!cart || !cart.items || cart.items.length === 0) return;

        // Check if there is an active bundle in cart
        const hasBundle = cart.items.some(item => {
          const props = item.properties || {};
          return props['_bundle_group'] || props['Includes'] || item.title?.includes('Includes:');
        });

        // If duplicate discount code (like BUNDLE15) is attached, remove it so it doesn't double-discount
        const hasDiscountCode = (cart.cart_level_discount_applications && cart.cart_level_discount_applications.length > 0) ||
                                (cart.discount_applications && cart.discount_applications.length > 0);

        if (hasBundle && hasDiscountCode) {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ discount: '' })
          });
          window.location.reload();
        }
      } catch(e) {
        console.error('Error syncing bundle cart price:', e);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncBundlePrice);
    } else {
      syncBundlePrice();
    }
    document.addEventListener('cart:updated', syncBundlePrice);
  })();
</script>

{% schema %}
{
  "name": "Smart Bundles",
  "target": "body",
  "settings": []
}
{% endschema %}
