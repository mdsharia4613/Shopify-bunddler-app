{%- assign widget_id = widget_instance_id | default: block.id | default: 'standalone' -%}
{%- assign is_standalone = is_standalone | default: false -%}
{% comment %}
  Volume Discounts App Block
  - Fully dynamic tiers loaded from App Metafield and synced with App API
  - Synchronized with theme's default ADD TO CART button
  - Renders exact modern styling with radio selection, save pills, corner badges, and gift ribbons
{% endcomment %}

{% if product %}
  {% comment %} Read Published Volume Discount from App Metafield {% endcomment %}
  {% assign vd_meta = app.metafields.smart_bundles.active_volume_discount.value %}
  {% if vd_meta == blank %}
    {% assign vd_meta = shop.metafields.smart_bundles.active_volume_discount.value %}
  {% endif %}

  {% comment %} Target Eligibility Check (All products / Selected products / Selected collections) {% endcomment %}
  {% assign is_eligible = false %}
  {% if vd_meta == blank %}
    {% assign is_eligible = true %}
  {% elsif vd_meta.active == false %}
    {% assign is_eligible = false %}
  {% elsif vd_meta.appliesTo == blank or vd_meta.appliesTo == 'all' %}
    {% assign is_eligible = true %}
  {% elsif vd_meta.appliesTo == 'products' %}
    {% assign current_pid = product.id | append: "" %}
    {% for pid in vd_meta.selectedProductIds %}
      {% assign clean_pid = pid | split: "/" | last %}
      {% if clean_pid == current_pid %}
        {% assign is_eligible = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% elsif vd_meta.appliesTo == 'collections' %}
    {% for col in product.collections %}
      {% assign current_cid = col.id | append: "" %}
      {% for cid in vd_meta.selectedCollectionIds %}
        {% assign clean_cid = cid | split: "/" | last %}
        {% if clean_cid == current_cid %}
          {% assign is_eligible = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if is_eligible %}{% break %}{% endif %}
    {% endfor %}
  {% endif %}

{% if is_eligible %}
  {% assign current_variant = product.selected_or_first_available_variant %}
  {% assign base_price = current_variant.price %}

  {% assign display_accent = block.settings.accent_color | default: "#f59e0b" %}
  {% assign display_header_title = block.settings.header_title %}

  {% if vd_meta %}
    {% if vd_meta.accentColor != blank %}
      {% assign display_accent = vd_meta.accentColor %}
    {% endif %}
    {% if vd_meta.headerTitle != blank %}
      {% assign display_header_title = vd_meta.headerTitle %}
    {% endif %}
  {% endif %}

  <div 
    class="vd-widget-container" 
    id="vd-widget-{{ widget_id }}" data-standalone="{% if is_standalone %}true{% else %}false{% endif %}"
    data-block-id="{{ widget_id }}"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-base-price="{{ base_price }}"
    data-currency="{{ cart.currency.symbol }}"
    style="
      --vd-accent: {{ display_accent }};{% if is_standalone %} display: none;{% endif %}
    "
  >
    <div class="vd-card-wrap">
      {% if display_header_title != blank %}
        <h3 class="vd-main-title">{{ display_header_title }}</h3>
      {% endif %}

      <!-- Tiers List -->
      <div class="vd-tiers-list" role="radiogroup" aria-label="Volume Discount Tiers">

        {% if vd_meta != blank and vd_meta.tiers != blank and vd_meta.tiers.size > 0 %}
          {% comment %} Render Tiers Configured & Published from App {% endcomment %}
          {% for tier in vd_meta.tiers %}
            {% assign tier_idx = forloop.index %}
            {% assign is_selected = false %}
            {% if vd_meta.defaultTier == tier_idx %}
              {% assign is_selected = true %}
            {% elsif vd_meta.defaultTier == blank and forloop.first %}
              {% assign is_selected = true %}
            {% endif %}

            {% assign raw_cents = base_price | times: tier.qty %}
            {% assign disc_pct = tier.discount | plus: 0 %}
            {% assign disc_cents = raw_cents | times: disc_pct | divided_by: 100 %}
            {% assign final_cents = raw_cents | minus: disc_cents %}

            <div class="vd-tier-card {% if is_selected %}is-selected{% endif %}" data-tier-card="{{ tier_idx }}">
              <div 
                class="vd-tier-row {% if is_selected %}is-selected{% endif %}"
                data-tier="{{ tier_idx }}"
                data-qty="{{ tier.qty }}"
                data-discount="{{ disc_pct }}"
                {% if tier.gift != blank and tier.gift.enabled %}
                  data-gift-type="{{ tier.gift.type }}"
                  data-gift-variant-id="{{ tier.gift.variantId }}"
                {% endif %}
                tabindex="0"
                role="radio"
                aria-checked="{% if is_selected %}true{% else %}false{% endif %}"
              >
                <!-- Floating Corner Badge -->
                {% if tier.popularBadge != blank %}
                  <div class="vd-popular-badge">
                    <span>ÃƒÂ¢Ã…â€œÃ‚Â¨</span>
                    <span>{{ tier.popularBadge }}</span>
                  </div>
                {% endif %}

                <!-- Left Column: Image (replaces radio) OR Radio Dot + Info -->
                <div class="vd-tier-left">
                  {% if tier.image != blank and tier.image.url != blank %}
                    <img 
                      src="{{ tier.image.url }}" 
                      alt="{{ tier.title }}" 
                      class="vd-tier-thumb"
                      style="width: {{ tier.image.size | default: 48 }}px; height: {{ tier.image.size | default: 48 }}px; border-radius: {{ tier.image.radius | default: 6 }}px; object-fit: cover; flex-shrink: 0;"
                    />
                  {% else %}
                    <span class="vd-radio-dot"></span>
                  {% endif %}
                  <div class="vd-tier-info">
                    <div class="vd-title-row">
                      <span class="vd-tier-title">{{ tier.title }}</span>
                      {% if tier.saveTag != blank %}
                        <span class="vd-save-pill">{{ tier.saveTag }}</span>
                      {% elsif disc_pct > 0 %}
                        <span class="vd-save-pill" data-save-pill="{{ tier_idx }}">
                          SAVE {{ disc_cents | money }}
                        </span>
                      {% endif %}
                    </div>
                    <div class="vd-tier-subtitle">
                      {% if tier.subtitle != blank %}
                        {{ tier.subtitle }}
                      {% elsif disc_pct > 0 %}
                        You save {{ disc_pct }}%
                      {% else %}
                        Standard price
                      {% endif %}
                    </div>
                  </div>
                </div>

                <!-- Right Column: Final Price + Strikethrough -->
                <div class="vd-tier-right">
                  <div class="vd-final-price" data-final-price="{{ tier_idx }}">
                    {{ final_cents | money }}
                  </div>
                  {% if disc_pct > 0 %}
                    <div class="vd-strikethrough-price" data-raw-price="{{ tier_idx }}">
                      {{ raw_cents | money }}
                    </div>
                  {% endif %}
                </div>
              </div>

              <!-- Bottom Attached Gift Ribbon -->
              {% if tier.gift != blank and tier.gift.enabled %}
                <div 
                  class="vd-tier-gift-bar {% unless is_selected %}vd-gift-hidden{% endunless %}" 
                  data-gift-bar="{{ tier_idx }}"
                >
                  {% if tier.gift.type == 'shipping' %}
                    <span>ÃƒÂ°Ã…Â¸Ã…Â¡Ã…Â¡</span>
                  {% elsif tier.gift.imageUrl != blank %}
                    <img 
                      src="{{ tier.gift.imageUrl }}" 
                      alt="Gift" 
                      style="width: {{ tier.gift.imageSize | default: 24 }}px; height: {{ tier.gift.imageSize | default: 24 }}px; border-radius: 4px; object-fit: cover;" 
                    />
                  {% else %}
                    <span>ÃƒÂ°Ã…Â¸Ã…Â½Ã‚Â</span>
                  {% endif %}
                  <span>{{ tier.gift.text | default: '+ FREE Gift' }}</span>
                </div>
              {% endif %}
            </div>
          {% endfor %}

        {% else %}
          {% comment %} Fallback: Pre-configured 3 Tiers (Single, Duo, Trio) matching the exact design {% endcomment %}
          
          <!-- Tier 1: Single -->
          <div class="vd-tier-card" data-tier-card="1">
            <div 
              class="vd-tier-row"
              data-tier="1"
              data-qty="1"
              data-discount="0"
              tabindex="0"
              role="radio"
              aria-checked="false"
            >
              <div class="vd-tier-left">
                <span class="vd-radio-dot"></span>
                <div class="vd-tier-info">
                  <div class="vd-title-row">
                    <span class="vd-tier-title">Single</span>
                  </div>
                  <div class="vd-tier-subtitle">Standard price</div>
                </div>
              </div>
              <div class="vd-tier-right">
                <div class="vd-final-price" data-final-price="1">
                  {{ base_price | times: 1 | money }}
                </div>
              </div>
            </div>
          </div>

          <!-- Tier 2: Duo (Popular) -->
          {% assign t2_raw = base_price | times: 2 %}
          {% assign t2_disc = t2_raw | times: 15 | divided_by: 100 %}
          {% assign t2_final = t2_raw | minus: t2_disc %}
          <div class="vd-tier-card is-selected" data-tier-card="2">
            <div 
              class="vd-tier-row is-selected"
              data-tier="2"
              data-qty="2"
              data-discount="15"
              tabindex="0"
              role="radio"
              aria-checked="true"
            >
              <div class="vd-popular-badge">
                <span>ÃƒÂ¢Ã…â€œÃ‚Â¨</span>
                <span>Most Popular</span>
              </div>

              <div class="vd-tier-left">
                <span class="vd-radio-dot"></span>
                <div class="vd-tier-info">
                  <div class="vd-title-row">
                    <span class="vd-tier-title">Duo</span>
                    <span class="vd-save-pill" data-save-pill="2">
                      SAVE {{ t2_disc | money }}
                    </span>
                  </div>
                  <div class="vd-tier-subtitle">You save 15%</div>
                </div>
              </div>
              <div class="vd-tier-right">
                <div class="vd-final-price" data-final-price="2">
                  {{ t2_final | money }}
                </div>
                <div class="vd-strikethrough-price" data-raw-price="2">
                  {{ t2_raw | money }}
                </div>
              </div>
            </div>
          </div>

          <!-- Tier 3: Trio -->
          {% assign t3_raw = base_price | times: 3 %}
          {% assign t3_disc = t3_raw | times: 20 | divided_by: 100 %}
          {% assign t3_final = t3_raw | minus: t3_disc %}
          <div class="vd-tier-card" data-tier-card="3">
            <div 
              class="vd-tier-row"
              data-tier="3"
              data-qty="3"
              data-discount="20"
              tabindex="0"
              role="radio"
              aria-checked="false"
            >
              <div class="vd-tier-left">
                <span class="vd-radio-dot"></span>
                <div class="vd-tier-info">
                  <div class="vd-title-row">
                    <span class="vd-tier-title">Trio</span>
                    <span class="vd-save-pill" data-save-pill="3">
                      SAVE {{ t3_disc | money }}
                    </span>
                  </div>
                  <div class="vd-tier-subtitle">You save 20%</div>
                </div>
              </div>
              <div class="vd-tier-right">
                <div class="vd-final-price" data-final-price="3">
                  {{ t3_final | money }}
                </div>
                <div class="vd-strikethrough-price" data-raw-price="3">
                  {{ t3_raw | money }}
                </div>
              </div>
            </div>
          </div>

        {% endif %}

      </div>

    </div>
  </div>

  <style>
    #vd-widget-{{ widget_id }} {
      margin: 20px 0;
      width: 100%;
      box-sizing: border-box;
      font-family: inherit;
    }

    #vd-widget-{{ block.id }} * {
      box-sizing: border-box;
    }

    #vd-widget-{{ block.id }} .vd-card-wrap {
      width: 100%;
    }

    #vd-widget-{{ block.id }} .vd-main-title {
      font-size: 17px;
      font-weight: 700;
      margin: 0 0 14px 0;
      color: #111827;
    }

    #vd-widget-{{ block.id }} .vd-tiers-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    #vd-widget-{{ block.id }} .vd-tier-row {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-radius: 12px;
      cursor: pointer;
      background: #fffefc;
      border: 1.5px solid #fde68a;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      user-select: none;
      outline: none;
    }

    #vd-widget-{{ block.id }} .vd-tier-card {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    #vd-widget-{{ block.id }} .vd-tier-row:hover {
      border-color: var(--vd-accent, #f59e0b);
      transform: translateY(-1px);
    }

    #vd-widget-{{ block.id }} .vd-tier-row.is-selected {
      background: #fffdf5;
      border: 2px solid var(--vd-accent, #f59e0b);
      box-shadow: 0 0 0 1px var(--vd-accent, #f59e0b);
    }

    #vd-widget-{{ block.id }} .vd-tier-card.is-selected .vd-tier-row {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      border-bottom: none;
    }

    #vd-widget-{{ block.id }} .vd-tier-gift-bar {
      background: var(--vd-accent, #f59e0b);
      color: #ffffff;
      padding: 7px 16px;
      font-weight: 700;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-bottom-left-radius: 10px;
      border-bottom-right-radius: 10px;
      margin-top: -2px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 10px -2px rgba(245, 158, 11, 0.25);
    }

    #vd-widget-{{ block.id }} .vd-tier-gift-bar.vd-gift-hidden {
      display: none !important;
    }

    #vd-widget-{{ block.id }} .vd-tier-thumb {
      border: 1px solid #e5e7eb;
    }

    /* Floating Most Popular Corner Badge */
    #vd-widget-{{ block.id }} .vd-popular-badge {
      position: absolute;
      top: -13px;
      right: 14px;
      background-color: var(--vd-accent, #f59e0b);
      color: #ffffff;
      padding: 3px 12px;
      border-radius: 20px;
      font-size: 11.5px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
      letter-spacing: 0.2px;
      z-index: 2;
    }

    /* Left Side: Radio & Info */
    #vd-widget-{{ block.id }} .vd-tier-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    #vd-widget-{{ block.id }} .vd-radio-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #fcd34d;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: #ffffff;
      transition: all 0.2s ease;
    }

    #vd-widget-{{ block.id }} .vd-tier-row.is-selected .vd-radio-dot {
      border: 2.5px solid var(--vd-accent, #f59e0b);
    }

    #vd-widget-{{ block.id }} .vd-tier-row.is-selected .vd-radio-dot::after {
      content: "";
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--vd-accent, #f59e0b);
    }

    #vd-widget-{{ block.id }} .vd-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #vd-widget-{{ block.id }} .vd-tier-title {
      font-size: 18px;
      font-weight: 700;
      color: #111827;
      line-height: 1.2;
    }

    #vd-widget-{{ block.id }} .vd-save-pill {
      background-color: #fef3c7;
      color: #92400e;
      font-size: 11.5px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    #vd-widget-{{ block.id }} .vd-tier-subtitle {
      font-size: 13.5px;
      color: #6b7280;
      margin-top: 3px;
    }

    /* Right Side: Price */
    #vd-widget-{{ block.id }} .vd-tier-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 2px;
    }

    #vd-widget-{{ block.id }} .vd-final-price {
      font-size: 19px;
      font-weight: 800;
      color: #111827;
    }

    #vd-widget-{{ block.id }} .vd-strikethrough-price {
      font-size: 13px;
      color: #9ca3af;
      text-decoration: line-through;
    }
  </style>

  <script>
    (function() {
      const container = document.getElementById('vd-widget-{{ widget_id }}');
      if (!container) return;

      // Auto-relocate if custom embed placeholder exists
      const customEmbed = document.querySelector('.smart-bundle-widget[data-widget-type="volume-discount"]');
      if (customEmbed && container.parentElement !== customEmbed) {
        customEmbed.appendChild(container);
        container.style.display = 'block';
      }

      const blockId = container.getAttribute('data-block-id');
      const productId = container.getAttribute('data-product-id');
      let currentVariantId = container.getAttribute('data-variant-id');
      let basePrice = parseInt(container.getAttribute('data-base-price'), 10);
      const currency = container.getAttribute('data-currency') || '$';

      const currentProductTitle = {{ product.title | json }};
      let currentProductImage = {{ product.featured_image | image_url: width: 300 | json }};

      function formatMoney(cents) {
        return currency + (cents / 100).toFixed(2);
      }

      function syncThemeQuantity(qty) {
        const qtyInputs = document.querySelectorAll('input[name="quantity"], input.quantity__input, [data-quantity-input]');
        qtyInputs.forEach(qtyInput => {
          if (qtyInput) {
            qtyInput.value = qty;
            qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
            qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
          }
        });
      }

      function bindTierEvents() {
        const tiers = container.querySelectorAll('.vd-tier-row');
        tiers.forEach(item => {
          item.onclick = function() {
            selectTier(this);
          };
          item.onkeydown = function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              selectTier(this);
            }
          };
        });
      }

      function selectTier(item, skipQtySync) {
        const tiers = container.querySelectorAll('.vd-tier-row');
        tiers.forEach(t => {
          t.classList.remove('is-selected');
          t.setAttribute('aria-checked', 'false');
          const card = t.closest('.vd-tier-card');
          if (card) card.classList.remove('is-selected');
        });

        item.classList.add('is-selected');
        item.setAttribute('aria-checked', 'true');
        const activeCard = item.closest('.vd-tier-card');
        if (activeCard) activeCard.classList.add('is-selected');

        // Toggle gift ribbons
        const allGiftBars = container.querySelectorAll('.vd-tier-gift-bar');
        allGiftBars.forEach(gb => gb.classList.add('vd-gift-hidden'));

        if (activeCard) {
          const cardGiftBar = activeCard.querySelector('.vd-tier-gift-bar');
          if (cardGiftBar) cardGiftBar.classList.remove('vd-gift-hidden');
        }

        const qty = parseInt(item.getAttribute('data-qty') || '1', 10);
        if (!skipQtySync) {
          syncThemeQuantity(qty);
        }
      }

      bindTierEvents();

      // Initial sync with default selected tier
      const initiallySelected = container.querySelector('.vd-tier-row.is-selected') || container.querySelector('.vd-tier-row');
      if (initiallySelected) {
        selectTier(initiallySelected);
      }

      // Listen to theme quantity selector changes to auto-select matching tier
      function listenToThemeQuantity() {
        document.addEventListener('change', function(e) {
          if (e.target.matches('input[name="quantity"], input.quantity__input, [data-quantity-input]')) {
            const inputVal = parseInt(e.target.value, 10);
            let matchedTier = null;
            const tiers = container.querySelectorAll('.vd-tier-row');
            tiers.forEach(t => {
              const tierQty = parseInt(t.getAttribute('data-qty') || '1', 10);
              if (tierQty === inputVal) matchedTier = t;
            });
            if (matchedTier && !matchedTier.classList.contains('is-selected')) {
              selectTier(matchedTier, true);
            }
          }
        });
      }
      listenToThemeQuantity();

      // Dynamic Price update on variant changes
      document.addEventListener('variant:change', function(evt) {
        if (evt.detail && evt.detail.variant) {
          currentVariantId = evt.detail.variant.id;
          basePrice = evt.detail.variant.price;
          if (evt.detail.variant.featured_image && evt.detail.variant.featured_image.src) {
            currentProductImage = evt.detail.variant.featured_image.src;
          }
          updateTierPrices();
        }
      });

      const form = document.querySelector('form[action*="/cart/add"]');
      if (form) {
        form.addEventListener('change', function(e) {
          if (e.target.name === 'id') {
            currentVariantId = e.target.value;
          }
        });
      }

      function updateTierPrices() {
        const tiers = container.querySelectorAll('.vd-tier-row');
        tiers.forEach(item => {
          const tierNum = item.getAttribute('data-tier');
          const qty = parseInt(item.getAttribute('data-qty') || '1', 10);
          const discount = parseInt(item.getAttribute('data-discount') || '0', 10);
          
          const rawCents = basePrice * qty;
          const savedCents = rawCents * (discount / 100);
          const finalCents = rawCents - savedCents;

          const finalPriceEl = item.querySelector('[data-final-price="' + tierNum + '"]');
          if (finalPriceEl) {
            finalPriceEl.textContent = formatMoney(finalCents);
          }

          const rawPriceEl = item.querySelector('[data-raw-price="' + tierNum + '"]');
          if (rawPriceEl) {
            rawPriceEl.textContent = formatMoney(rawCents);
          }

          const savePillEl = item.querySelector('[data-save-pill="' + tierNum + '"]');
          if (savePillEl && discount > 0) {
            savePillEl.textContent = 'SAVE ' + formatMoney(savedCents);
          }
        });
      }

      // Client-side dynamic tier sync from App API
      async function syncTiersFromApi() {
        try {
          const res = await fetch('/api/bundles');
          if (!res.ok) return;
          const data = await res.json();
          if (!data || !data.bundles) return;

          const vdBundles = data.bundles.filter(b => b.strategy === 'Volume Discounts' && b.status === 'Active');
          if (vdBundles.length === 0) return;
          const activeConfig = vdBundles[0].config;
          if (!activeConfig || !activeConfig.tiers || activeConfig.tiers.length === 0) return;

          // Check eligibility
          const currentPid = '{{ product.id }}';
          if (activeConfig.appliesTo === 'products' && activeConfig.selectedProducts && activeConfig.selectedProducts.length > 0) {
            const matchesProduct = activeConfig.selectedProducts.some(p => {
              const cleanId = String(p.id).split('/').pop();
              return cleanId === currentPid;
            });
            if (!matchesProduct) return;
          }

          renderDynamicTiers(activeConfig);
        } catch(e) {
          console.warn('Volume discount dynamic sync info:', e);
        }
      }

      function renderDynamicTiers(config) {
        const tiersList = container.querySelector('.vd-tiers-list');
        if (!tiersList) return;

        const defaultTierIndex = config.defaultTier || 2;
        let html = '';

        config.tiers.forEach((tier, idx) => {
          const tierNum = idx + 1;
          const isSelected = tierNum === defaultTierIndex;
          const qty = parseInt(tier.qty || '1', 10);
          const discount = parseFloat(tier.discount || '0');
          const rawCents = basePrice * qty;
          const savedCents = Math.round(rawCents * (discount / 100));
          const finalCents = rawCents - savedCents;

          let giftAttr = '';
          if (tier.gift && tier.gift.enabled) {
            giftAttr = `data-gift-type="${tier.gift.type || 'gift'}" data-gift-variant-id="${tier.gift.variantId || ''}"`;
          }

          let popBadgeHtml = '';
          if (tier.popularBadge) {
            popBadgeHtml = `
              <div class="vd-popular-badge">
                <span>ÃƒÂ¢Ã…â€œÃ‚Â¨</span>
                <span>${tier.popularBadge}</span>
              </div>
            `;
          }

          let leftThumbHtml = '<span class="vd-radio-dot"></span>';
          if (tier.image && tier.image.url) {
            const imgSize = tier.image.size || 48;
            const imgRadius = tier.image.radius || 6;
            leftThumbHtml = `<img src="${tier.image.url}" alt="${tier.title}" class="vd-tier-thumb" style="width:${imgSize}px; height:${imgSize}px; border-radius:${imgRadius}px; object-fit:cover; flex-shrink:0;" />`;
          }

          let savePillHtml = '';
          if (tier.saveTag) {
            savePillHtml = `<span class="vd-save-pill">${tier.saveTag}</span>`;
          } else if (discount > 0) {
            savePillHtml = `<span class="vd-save-pill" data-save-pill="${tierNum}">SAVE ${formatMoney(savedCents)}</span>`;
          }

          let subtitleHtml = tier.subtitle || (discount > 0 ? `You save ${discount}%` : 'Standard price');

          let strikethroughHtml = '';
          if (discount > 0) {
            strikethroughHtml = `<div class="vd-strikethrough-price" data-raw-price="${tierNum}">${formatMoney(rawCents)}</div>`;
          }

          let giftBarHtml = '';
          if (tier.gift && tier.gift.enabled) {
            const icon = tier.gift.type === 'shipping' ? 'ÃƒÂ°Ã…Â¸Ã…Â¡Ã…Â¡' : (tier.gift.imageUrl ? `<img src="${tier.gift.imageUrl}" style="width:24px; height:24px; border-radius:4px; object-fit:cover;" />` : 'ÃƒÂ°Ã…Â¸Ã…Â½Ã‚Â');
            const giftText = tier.gift.text || '+ FREE Gift';
            giftBarHtml = `
              <div class="vd-tier-gift-bar ${isSelected ? '' : 'vd-gift-hidden'}" data-gift-bar="${tierNum}">
                <span>${icon}</span>
                <span>${giftText}</span>
              </div>
            `;
          }

          html += `
            <div class="vd-tier-card ${isSelected ? 'is-selected' : ''}" data-tier-card="${tierNum}">
              <div 
                class="vd-tier-row ${isSelected ? 'is-selected' : ''}"
                data-tier="${tierNum}"
                data-qty="${qty}"
                data-discount="${discount}"
                ${giftAttr}
                tabindex="0"
                role="radio"
                aria-checked="${isSelected ? 'true' : 'false'}"
              >
                ${popBadgeHtml}
                <div class="vd-tier-left">
                  ${leftThumbHtml}
                  <div class="vd-tier-info">
                    <div class="vd-title-row">
                      <span class="vd-tier-title">${tier.title}</span>
                      ${savePillHtml}
                    </div>
                    <div class="vd-tier-subtitle">${subtitleHtml}</div>
                  </div>
                </div>
                <div class="vd-tier-right">
                  <div class="vd-final-price" data-final-price="${tierNum}">${formatMoney(finalCents)}</div>
                  ${strikethroughHtml}
                </div>
              </div>
              ${giftBarHtml}
            </div>
          `;
        });

        tiersList.innerHTML = html;
        bindTierEvents();

        const activeTier = container.querySelector('.vd-tier-row.is-selected') || container.querySelector('.vd-tier-row');
        if (activeTier) {
          selectTier(activeTier);
        }
      }

      syncTiersFromApi();

      // Add to cart execution synced with Shopify's default Add to Cart button
      let isSubmitting = false;

      async function handleVolumeAddToCart(triggerBtn) {
        if (isSubmitting) return;

        const selected = container.querySelector('.vd-tier-row.is-selected');
        if (!selected) return;

        const qty = parseInt(selected.getAttribute('data-qty') || '1', 10);
        const discount = parseFloat(selected.getAttribute('data-discount') || '0');
        const tierTitle = selected.querySelector('.vd-tier-title') ? selected.querySelector('.vd-tier-title').textContent.trim() : (selected.getAttribute('data-title') || 'Tier');
        const giftType = selected.getAttribute('data-gift-type');
        const giftVariantId = selected.getAttribute('data-gift-variant-id');

        isSubmitting = true;

        // Button loading state on theme's default ADD TO CART button
        const themeBtn = triggerBtn || document.querySelector('form[action*="/cart/add"] button[type="submit"], form[action*="/cart/add"] [name="add"], .product-form__submit');
        let originalBtnHtml = '';
        if (themeBtn) {
          originalBtnHtml = themeBtn.innerHTML;
          themeBtn.setAttribute('aria-disabled', 'true');
          themeBtn.disabled = true;
          themeBtn.classList.add('loading');
          const btnSpan = themeBtn.querySelector('span:not(.loader)') || themeBtn;
          if (btnSpan && btnSpan.textContent) {
            btnSpan.textContent = 'Adding to cart...';
          }
        }

        try {
          const rawCents = basePrice * qty;
          const savedCents = Math.round(rawCents * (discount / 100));
          const finalCents = rawCents - savedCents;

          let items = [];

          const discountCode = 'VD' + Math.round(discount);
          if (qty >= 2 && discount > 0) {
            const bundleGroupId = 'vd_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6);
            const parentVarGid = 'gid://shopify/ProductVariant/' + currentVariantId;
            const fullTitle = currentProductTitle + ' (' + tierTitle + ')';
            const componentsText = currentProductTitle + ' x ' + qty;

            items.push({
              id: parseInt(currentVariantId, 10),
              quantity: qty,
              properties: {
                '_bundle': 'Volume Discount',
                '_bundle_type': 'volume_discount',
                '_bundle_group': bundleGroupId,
                '_bundle_title': fullTitle,
                '_bundle_components': componentsText,
                '_bundle_discount': discount + '%',
                '_bundle_discount_num': discount.toString(),
                '_bundle_discount_code': discountCode,
                '_bundle_original_cents': rawCents.toString(),
                '_bundle_discounted_cents': finalCents.toString(),
                '_bundle_image': currentProductImage || '',
                '_bundle_parent_variant_id': parentVarGid,
                '_volume_tier': tierTitle
              }
            });
          } else {
            // Standard single item
            items.push({
              id: parseInt(currentVariantId, 10),
              quantity: qty
            });
          }

          // If a free gift product is configured, add to cart
          if (giftType === 'gift' && giftVariantId) {
            const cleanGid = giftVariantId.split('/').pop();
            items.push({
              id: parseInt(cleanGid, 10),
              quantity: 1,
              properties: {
                '_bundle_type': 'volume_discount_gift',
                '_free_gift': 'true',
                '_bundle_parent': tierTitle
              }
            });
          }

          const bodyPayload = { items };
          if (giftType === 'shipping') {
            bodyPayload.attributes = {
              '_free_shipping': 'true',
              '_volume_tier': tierTitle
            };
          }

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(bodyPayload)
          });

          if (response.ok) {
            setTimeout(function() {
              window.location.href = '/cart';
            }, 250);
          } else {
            const err = await response.json();
            throw new Error(err.description || 'Could not add to cart.');
          }
        } catch (err) {
          isSubmitting = false;
          if (themeBtn) {
            themeBtn.removeAttribute('aria-disabled');
            themeBtn.disabled = false;
            themeBtn.classList.remove('loading');
            if (originalBtnHtml) themeBtn.innerHTML = originalBtnHtml;
          }
          alert(err.message || 'Error adding to cart.');
        }
      }

      // Sync and intercept default Shopify "ADD TO CART" button
      function interceptDefaultAddToCart() {
        // Intercept form submit event in capture phase
        document.addEventListener('submit', function(e) {
          const form = e.target.closest('form[action*="/cart/add"]');
          if (!form) return;

          const selected = container.querySelector('.vd-tier-row.is-selected');
          if (!selected) return;

          const qty = parseInt(selected.getAttribute('data-qty') || '1', 10);
          const discount = parseFloat(selected.getAttribute('data-discount') || '0');

          if (qty >= 2 && discount > 0) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            const btn = form.querySelector('button[type="submit"], [name="add"], .product-form__submit');
            handleVolumeAddToCart(btn);
            return false;
          }
        }, true);

        // Intercept direct button click in capture phase (for AJAX themes like Dawn)
        document.addEventListener('click', function(e) {
          const btn = e.target.closest('button[type="submit"][name="add"], .product-form__submit, [name="add"], button[name="add"], .btn--add-to-cart');
          if (!btn) return;

          const selected = container.querySelector('.vd-tier-row.is-selected');
          if (!selected) return;

          const qty = parseInt(selected.getAttribute('data-qty') || '1', 10);
          const discount = parseFloat(selected.getAttribute('data-discount') || '0');

          if (qty >= 2 && discount > 0) {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            handleVolumeAddToCart(btn);
            return false;
          }
        }, true);
      }

      interceptDefaultAddToCart();

    })();
  </script>
  {% endif %}
{% endif %}