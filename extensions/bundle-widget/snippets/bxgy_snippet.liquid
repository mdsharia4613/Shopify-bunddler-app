{%- assign widget_id = widget_instance_id | default: block.id | default: 'standalone' -%}
{%- assign is_standalone = is_standalone | default: false -%}
{% comment %}
  Buy X, Get Y (BXGY) Deal App Block
{% endcomment %}

{% if product %}
  {% assign bxgy_meta = app.metafields.smart_bundles.active_bxgy.value %}
  {% if bxgy_meta == blank %}
    {% assign bxgy_meta = shop.metafields.smart_bundles.active_bxgy.value %}
  {% endif %}

  {% assign is_eligible = false %}
  {% if bxgy_meta == blank %}
    {% assign is_eligible = true %}
  {% elsif bxgy_meta.active == false %}
    {% assign is_eligible = false %}
  {% elsif bxgy_meta.appliesTo == blank or bxgy_meta.appliesTo == 'all' %}
    {% assign is_eligible = true %}
  {% elsif bxgy_meta.appliesTo == 'products' %}
    {% assign current_pid = product.id | append: '' %}
    {% for pid in bxgy_meta.selectedProductIds %}
      {% assign clean_pid = pid | split: '/' | last %}
      {% if clean_pid == current_pid %}
        {% assign is_eligible = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% elsif bxgy_meta.appliesTo == 'collections' %}
    {% for col in product.collections %}
      {% assign current_cid = col.id | append: '' %}
      {% for cid in bxgy_meta.selectedCollectionIds %}
        {% assign clean_cid = cid | split: '/' | last %}
        {% if clean_cid == current_cid %}
          {% assign is_eligible = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if is_eligible %}{% break %}{% endif %}
    {% endfor %}
  {% endif %}

  {% if is_eligible %}
    {{ 'bxgy_widget.css' | asset_url | stylesheet_tag }}

    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign base_price = current_variant.price %}
    {% assign display_accent = block.settings.accent_color | default: '#f59e0b' %}
    {% assign display_header_title = block.settings.header_title | default: 'Buy X, Get Y (BXGY) Special' %}

    {% if bxgy_meta %}
      {% if bxgy_meta.accentColor != blank %}
        {% assign display_accent = bxgy_meta.accentColor %}
      {% endif %}
      {% if bxgy_meta.headerTitle != blank %}
        {% assign display_header_title = bxgy_meta.headerTitle %}
      {% endif %}
    {% endif %}

    <div
      class="bxgy-widget-container"
      id="bxgy-widget-{{ widget_id }}" data-standalone="{% if is_standalone %}true{% else %}false{% endif %}"
      data-bxgy-widget="true"
      data-block-id="{{ widget_id }}"
      data-product-id="{{ product.id }}"
      data-variant-id="{{ current_variant.id }}"
      data-base-price="{{ base_price }}"
      data-currency="{{ cart.currency.symbol }}"
      data-product-title="{{ product.title | escape }}"
      data-product-image="{{ product.featured_image | image_url: width: 300 }}"
      style="--bxgy-accent: {{ display_accent }};{% if is_standalone %} display: none;{% endif %}"
    >
      <div class="bxgy-card-wrap">
        {% if display_header_title != blank %}
          <h3 class="bxgy-main-title">{{ display_header_title }}</h3>
        {% endif %}

        <div class="bxgy-tiers-list" role="radiogroup" aria-label="Buy X Get Y Tiers">
          {% if bxgy_meta != blank and bxgy_meta.tiers != blank and bxgy_meta.tiers.size > 0 %}
            {% for tier in bxgy_meta.tiers %}
              {% assign tier_idx = forloop.index %}
              {% assign is_selected = false %}
              {% if bxgy_meta.defaultTier == tier_idx %}
                {% assign is_selected = true %}
              {% elsif bxgy_meta.defaultTier == blank and forloop.first %}
                {% assign is_selected = true %}
              {% endif %}

              {% assign total_qty = tier.totalQty | default: tier.qty | plus: 0 %}
              {% if total_qty < 1 %}
                {% assign total_qty = tier.buyQty | plus: tier.getQty %}
              {% endif %}

              {% assign raw_cents = base_price | times: total_qty %}
              {% assign disc_pct = tier.discount | plus: 0 %}
              {% assign disc_cents = raw_cents | times: disc_pct | divided_by: 100 %}
              {% assign final_cents = raw_cents | minus: disc_cents %}

              <div class="bxgy-tier-card {% if is_selected %}is-selected{% endif %}" data-tier-card="{{ tier_idx }}">
                <div
                  class="bxgy-tier-row {% if is_selected %}is-selected{% endif %}"
                  data-tier="{{ tier_idx }}"
                  data-qty="{{ total_qty }}"
                  data-buy-qty="{{ tier.buyQty | default: 1 }}"
                  data-get-qty="{{ tier.getQty | default: 0 }}"
                  data-discount="{{ disc_pct }}"
                  data-title="{{ tier.title }}"
                  tabindex="0"
                  role="radio"
                  aria-checked="{% if is_selected %}true{% else %}false{% endif %}"
                >
                  {% if tier.popularBadge != blank %}
                    <div class="bxgy-popular-badge">
                      <span>⚡</span>
                      <span>{{ tier.popularBadge }}</span>
                    </div>
                  {% endif %}

                  <div class="bxgy-tier-left">
                    <span class="bxgy-radio-dot"></span>
                    <div class="bxgy-tier-info">
                      <span class="bxgy-tier-title">{{ tier.title }}</span>
                      <span class="bxgy-tier-subtext">
                        {% if tier.getQty > 0 %}
                          {{ tier.buyQty }} Paid + {{ tier.getQty }} Free ({{ total_qty }} total items)
                        {% else %}
                          {{ tier.buyQty }} Item{% if tier.buyQty > 1 %}s{% endif %} (Standard)
                        {% endif %}
                      </span>
                    </div>
                  </div>

                  <div class="bxgy-tier-right">
                    {% if disc_pct > 0 and tier.saveTag != blank %}
                      <span class="bxgy-save-tag">{{ tier.saveTag }}</span>
                    {% elsif disc_pct > 0 %}
                      <span class="bxgy-save-tag">SAVE {{ disc_pct }}%</span>
                    {% endif %}
                    <div class="bxgy-final-price" data-final-price="{{ tier_idx }}">
                      {{ final_cents | money }}
                    </div>
                    {% if disc_pct > 0 %}
                      <div class="bxgy-raw-price" data-raw-price="{{ tier_idx }}">
                        {{ raw_cents | money }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <!-- Initial Fallback Tier 1 -->
            {% assign t1_raw = base_price | times: 1 %}
            <div class="bxgy-tier-card is-selected" data-tier-card="1">
              <div class="bxgy-tier-row is-selected" data-tier="1" data-qty="1" data-buy-qty="1" data-get-qty="0" data-discount="0" data-title="Buy 1" tabindex="0" role="radio" aria-checked="true">
                <div class="bxgy-tier-left">
                  <span class="bxgy-radio-dot"></span>
                  <div class="bxgy-tier-info">
                    <span class="bxgy-tier-title">Buy 1</span>
                    <span class="bxgy-tier-subtext">1 Item (Standard)</span>
                  </div>
                </div>
                <div class="bxgy-tier-right">
                  <div class="bxgy-final-price" data-final-price="1">{{ t1_raw | money }}</div>
                </div>
              </div>
            </div>

            <!-- Initial Fallback Tier 2 -->
            {% assign t2_raw = base_price | times: 5 %}
            {% assign t2_disc = t2_raw | times: 60 | divided_by: 100 %}
            {% assign t2_final = t2_raw | minus: t2_disc %}
            <div class="bxgy-tier-card" data-tier-card="2">
              <div class="bxgy-tier-row" data-tier="2" data-qty="5" data-buy-qty="2" data-get-qty="3" data-discount="60" data-title="Buy 2 Get 3 Free" tabindex="0" role="radio" aria-checked="false">
                <div class="bxgy-popular-badge"><span>⚡</span><span>Best Value</span></div>
                <div class="bxgy-tier-left">
                  <span class="bxgy-radio-dot"></span>
                  <div class="bxgy-tier-info">
                    <span class="bxgy-tier-title">Buy 2 Get 3 Free</span>
                    <span class="bxgy-tier-subtext">2 Paid + 3 Free (5 total items)</span>
                  </div>
                </div>
                <div class="bxgy-tier-right">
                  <span class="bxgy-save-tag">SAVE 60%</span>
                  <div class="bxgy-final-price" data-final-price="2">{{ t2_final | money }}</div>
                  <div class="bxgy-raw-price" data-raw-price="2">{{ t2_raw | money }}</div>
                </div>
              </div>
            </div>

            <!-- Initial Fallback Tier 3 -->
            {% assign t3_raw = base_price | times: 5 %}
            {% assign t3_disc = t3_raw | times: 40 | divided_by: 100 %}
            {% assign t3_final = t3_raw | minus: t3_disc %}
            <div class="bxgy-tier-card" data-tier-card="3">
              <div class="bxgy-tier-row" data-tier="3" data-qty="5" data-buy-qty="3" data-get-qty="2" data-discount="40" data-title="Buy 3 Get 2 Free" tabindex="0" role="radio" aria-checked="false">
                <div class="bxgy-tier-left">
                  <span class="bxgy-radio-dot"></span>
                  <div class="bxgy-tier-info">
                    <span class="bxgy-tier-title">Buy 3 Get 2 Free</span>
                    <span class="bxgy-tier-subtext">3 Paid + 2 Free (5 total items)</span>
                  </div>
                </div>
                <div class="bxgy-tier-right">
                  <span class="bxgy-save-tag">SAVE 40%</span>
                  <div class="bxgy-final-price" data-final-price="3">{{ t3_final | money }}</div>
                  <div class="bxgy-raw-price" data-raw-price="3">{{ t3_raw | money }}</div>
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <script src="{{ 'bxgy_widget.js' | asset_url }}" defer="defer"></script>
  {% endif %}
{% endif %}